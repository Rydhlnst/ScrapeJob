COMPOSE_PROJECT_NAME=scrapejob

SERVICE_FQDN_FRONTEND=https://jobs.example.com
SERVICE_FQDN_BACKEND=https://api.example.com

FRONTEND_PORT=3000
BACKEND_PORT=8000

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
INTERNAL_API_BASE_URL=http://backend
NEXT_PUBLIC_USE_MOCK=false
API_BEARER_TOKEN=

APP_NAME="Job Loker API"
APP_ENV=production
APP_KEY=base64:replace-with-generated-laravel-app-key
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://jobs.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=jobs.example.com

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=job_platform
DB_USERNAME=scrapejob
DB_PASSWORD=change-me

POSTGRES_DB=job_platform
POSTGRES_USER=scrapejob
POSTGRES_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Job Loker API"

SCRAPER_ACTIVE_SOURCES=glints,jobstreet
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=0 */8 * * *
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_SCHEDULE_WITHOUT_OVERLAPPING_MINUTES=480
SCRAPER_NOTIFY_EMAILS=
GLINTS_KEYWORDS=software engineer,backend,frontend
GLINTS_COUNTRIES=ID
JOBSTREET_KEYWORDS=software,developer,engineer
SCRAPER_INTERNAL_API_TOKEN=replace-with-long-random-token
SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=python3
SCRAPER_LOG_LEVEL=INFO
SCRAPER_SAVE_JSON=false
SCRAPER_SEND_TO_LARAVEL=true
LARAVEL_API_BASE_URL=http://backend/api
LARAVEL_IMPORT_PATH=/internal/scraped-jobs/import

QUEUE_TRIES=3
QUEUE_TIMEOUT=900

NODE_PATH=node
PUPPETEER_TIMEOUT=120

# AI Cleanup Configuration
AI_CLEANUP_ENABLED=true
AI_CLEANUP_URL=http://frontend:3000/api/internal/clean-job

# AI Provider Select: 'deepseek' or 'ollama' (default: deepseek)
AI_PROVIDER=deepseek

# Deepseek Config (required if AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Ollama Config (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3
