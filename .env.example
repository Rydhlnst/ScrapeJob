# ─── Docker Compose ───────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=scrapejob

# ─── Domain / FQDN ───────────────────────────────────────────────────────────
SERVICE_FQDN_FRONTEND=http://your-vps-ip
SERVICE_FQDN_BACKEND=http://your-vps-ip

# ─── Ports ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ─── Public (baked into client bundle at build time) ─────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://your-vps-ip:8000
NEXT_PUBLIC_USE_MOCK=false

# ─── Server-side runtime ─────────────────────────────────────────────────────
INTERNAL_API_BASE_URL=http://backend
API_BEARER_TOKEN=

# ─── Laravel App ──────────────────────────────────────────────────────────────
APP_NAME="Job Loker API"
APP_ENV=production
APP_KEY=base64:GENERATE_ME_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=http://your-vps-ip:8000
FRONTEND_URL=http://your-vps-ip:3000
CMS_ADMIN_DOMAIN=lowonganku.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# ─── Cache & Queue ────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-vps-ip
SANCTUM_STATEFUL_DOMAINS=your-vps-ip

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=job_platform
DB_USERNAME=scrapejob
DB_PASSWORD=change-me-to-strong-password

POSTGRES_DB=job_platform
POSTGRES_USER=scrapejob
POSTGRES_PASSWORD=change-me-to-strong-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Job Loker API"

# ─── Scraper Sources ─────────────────────────────────────────────────────────
SCRAPER_ACTIVE_SOURCES=glints,jobstreet,jobstreetexpress,kalibrr,lokerid
SCRAPER_RUN_ON_STARTUP=true
HTTP_RETRIES=3
SCRAPE_ATTEMPTS=2
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=0 */8 * * *
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_SCHEDULE_WITHOUT_OVERLAPPING_MINUTES=480
SCRAPER_NOTIFY_EMAILS=
GLINTS_KEYWORDS=software engineer,backend,frontend
GLINTS_COUNTRIES=ID
JOBSTREET_KEYWORDS=software,developer,engineer
SCRAPER_INTERNAL_API_TOKEN=change-me-to-long-random-token

# ─── Laravel Deploy ───────────────────────────────────────────────────────────
# The compose `migrate` service runs migrations, all seeders, and the initial scrape.
RUN_MIGRATIONS=false
ENABLE_LARAVEL_CACHE_WARMUP=true

# ─── Admin Credentials ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=change-me-to-strong-password

# ─── Scraper Python ───────────────────────────────────────────────────────────
SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=python3
SCRAPER_LOG_LEVEL=INFO
SCRAPER_SAVE_JSON=false
SCRAPER_SEND_TO_LARAVEL=true
LARAVEL_API_BASE_URL=http://backend/api
LARAVEL_IMPORT_PATH=/internal/scraped-jobs/import

# ─── Queue Worker ─────────────────────────────────────────────────────────────
QUEUE_TRIES=3
QUEUE_TIMEOUT=900

# ─── Puppeteer ────────────────────────────────────────────────────────────────
NODE_PATH=node
PUPPETEER_TIMEOUT=120

# ─── AI Cleanup ───────────────────────────────────────────────────────────────
AI_CLEANUP_ENABLED=false
AI_CLEANUP_URL=http://frontend:3000/api/internal/clean-job

# AI provider: 'deepseek' or 'ollama'
AI_PROVIDER=ollama

# Deepseek (required if AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Ollama Cloud (required if AI_PROVIDER=ollama)
# Free: https://ollama.com | Pro: $20/mo
OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_MODEL=llama3
