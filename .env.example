# Frontend runtime mode
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_JOB_DATA_MODE=api

# Laravel backend base URL (tanpa trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional: override URL untuk server-side fetch di Docker / SSR
INTERNAL_API_BASE_URL=

# Optional: bearer token untuk server-side fetch ke endpoint /api/admin/*
# Isi dari token Sanctum admin jika butuh render data admin di Server Component
API_BEARER_TOKEN=
