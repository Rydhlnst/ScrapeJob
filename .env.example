# ─── Public (baked into client bundle at build time) ─────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK=false

# ─── Server-side runtime (inject via Docker environment:, never build args) ──
# Internal URL for SSR/server-component fetches (Docker: http://backend)
INTERNAL_API_BASE_URL=

# Sanctum bearer token for server-component admin data fetching (optional)
API_BEARER_TOKEN=

# Token shared between Next.js and Laravel for /api/internal/* routes
# REQUIRED for AI cleanup — generate: openssl rand -hex 32
SCRAPER_INTERNAL_API_TOKEN=

# ─── AI Cleanup Configuration ────────────────────────────────────────────────
# Enable AI-powered job data cleanup
AI_CLEANUP_ENABLED=true
AI_CLEANUP_URL=http://frontend:3000/api/internal/clean-job

# AI provider: 'deepseek' or 'ollama'
AI_PROVIDER=deepseek

# Deepseek Config (required if AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Ollama Config (required if AI_PROVIDER=ollama)
# Free tier: https://ollama.com (included with account)
# Pro tier: $20/mo for more usage
OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3
