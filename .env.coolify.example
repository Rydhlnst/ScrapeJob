# ============================================================
# ScrapeJob — Coolify Environment Template
# Copy to .env.coolify (gitignored) and fill in real secrets,
# or use bulk import directly in Coolify.
# Frontend : https://scrape.beres.io
# Backend  : https://scrapejob.beres.io
# ============================================================

COMPOSE_PROJECT_NAME=scrapejob

# ---------- Frontend (Next.js -> scrape.beres.io) ----------
NEXT_PUBLIC_API_BASE_URL=https://scrapejob.beres.io
INTERNAL_API_BASE_URL=http://backend
NEXT_PUBLIC_USE_MOCK=false
# SSR service token — isi setelah deploy pertama:
# 1. Masuk backend container: php artisan sanctum:create-token scrape-frontend
# 2. Copy token yang muncul, paste di sini, lalu redeploy frontend.
API_BEARER_TOKEN=

# ---------- Backend (Laravel -> scrapejob.beres.io) ----------
APP_NAME="Job Loker API"
APP_ENV=production
APP_KEY=base64:replace-with-generated-laravel-app-key
APP_DEBUG=false
APP_URL=https://scrapejob.beres.io
FRONTEND_URL=https://scrape.beres.io
CMS_ADMIN_DOMAIN=lowonganku.com

# The one-shot `migrate` service runs migrations, all seeders, and an initial scrape on rebuild.
SCRAPER_RUN_ON_STARTUP=true
ENABLE_LARAVEL_CACHE_WARMUP=true

CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_DOMAIN=.beres.io
SANCTUM_STATEFUL_DOMAINS=scrape.beres.io

# ---------- Database (Postgres) ----------
POSTGRES_DB=job_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- Scraper ----------
SCRAPER_ACTIVE_SOURCES=glints,jobstreet,jobstreetexpress,kalibrr,lokerid
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=0 */8 * * *
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_INTERNAL_API_TOKEN=replace-with-long-random-token

# ---------- Admin (login di /admin) ----------
ADMIN_EMAIL=admin@beres.io
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=replace-with-strong-password

# ---------- AI Cleanup via Ollama Cloud ----------
# API key: https://ollama.com/settings/keys
AI_CLEANUP_ENABLED=true
AI_CLEANUP_URL=http://frontend:3000/api/internal/clean-job
AI_PROVIDER=ollama
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace-with-ollama-cloud-api-key
OLLAMA_MODEL=deepseek-v4-flash

# ---------- Logging ----------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---------- Queue Worker ----------
QUEUE_TRIES=3
QUEUE_TIMEOUT=900
