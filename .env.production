COMPOSE_PROJECT_NAME=scrapejob

SERVICE_FQDN_FRONTEND=https://scrape.beres.io
SERVICE_FQDN_BACKEND=https://scrapejob.beres.io

NEXT_PUBLIC_API_BASE_URL=https://scrapejob.beres.io
INTERNAL_API_BASE_URL=http://backend
NEXT_PUBLIC_USE_MOCK=false
API_BEARER_TOKEN=

APP_NAME="Job Loker API"
APP_ENV=production
APP_KEY=base64:GENERATE_ME_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://scrapejob.beres.io
FRONTEND_URL=https://scrape.beres.io
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.beres.io
SANCTUM_STATEFUL_DOMAINS=scrape.beres.io

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5433
DB_DATABASE=job_platform
DB_USERNAME=postgres
DB_PASSWORD=change-me-to-strong-password

POSTGRES_DB=job_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-strong-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@beres.io
MAIL_FROM_NAME="Job Loker API"

SCRAPER_ACTIVE_SOURCES=glints,jobstreet
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON=0 */8 * * *
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_SCHEDULE_WITHOUT_OVERLAPPING_MINUTES=480
SCRAPER_NOTIFY_EMAILS=
GLINTS_KEYWORDS=software engineer,backend,frontend
GLINTS_COUNTRIES=ID
JOBSTREET_KEYWORDS=software,developer,engineer
SCRAPER_INTERNAL_API_TOKEN=change-me-to-long-random-token

RUN_MIGRATIONS=false
ENABLE_LARAVEL_CACHE_WARMUP=true

ADMIN_EMAIL=admin@beres.io
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=change-me-to-strong-password
SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=python3
SCRAPER_LOG_LEVEL=INFO
SCRAPER_SAVE_JSON=false
SCRAPER_SEND_TO_LARAVEL=true
LARAVEL_API_BASE_URL=http://backend/api
LARAVEL_IMPORT_PATH=/internal/scraped-jobs/import

QUEUE_TRIES=3
QUEUE_TIMEOUT=900

NODE_PATH=node
PUPPETEER_TIMEOUT=120

AI_CLEANUP_ENABLED=false
AI_CLEANUP_URL=http://frontend:3000/api/internal/clean-job

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
