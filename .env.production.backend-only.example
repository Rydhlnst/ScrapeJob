# Project Name
COMPOSE_PROJECT_NAME=scrapejob-backend

# VPS Exposed Port
BACKEND_PORT=8000

# Laravel Base Configuration
APP_NAME="Job Loker API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:replace-with-generated-laravel-app-key # Run: echo "base64:"$(openssl rand -base64 32) to generate

# APP_URL is the public API URL pointing to this VPS (without trailing slash)
APP_URL=https://api.yourdomain.com # OR http://<vps-ip>:8000

# FRONTEND_URL is the public Next.js frontend URL hosted on Vercel
FRONTEND_URL=https://your-app.vercel.app

# Cross-origin authentication configuration
# SANCTUM_STATEFUL_DOMAINS should match the hostname of your Vercel frontend
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# SESSION_DOMAIN should match the domain or subdomain of Vercel (optional, dot prefix covers subdomains)
SESSION_DOMAIN=.your-app.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# PostgreSQL Setup
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=job_platform
DB_USERNAME=scrapejob
DB_PASSWORD=replace-with-secure-database-password

POSTGRES_DB=job_platform
POSTGRES_USER=scrapejob
POSTGRES_PASSWORD=replace-with-secure-database-password

# Redis Setup
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail Setup (optional)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Job Loker API"

# Scraper Settings
SCRAPER_ACTIVE_SOURCES=glints,jobstreet
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON="0 */8 * * *" # Runs every 8 hours
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_SCHEDULE_WITHOUT_OVERLAPPING_MINUTES=480
SCRAPER_NOTIFY_EMAILS=
GLINTS_KEYWORDS="software engineer,backend,frontend"
GLINTS_COUNTRIES=ID
JOBSTREET_KEYWORDS="software,developer,engineer"

# Scraper API Protection (MUST match token configured in Vercel environment)
SCRAPER_INTERNAL_API_TOKEN=replace-with-long-random-token-here

SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=python3
SCRAPER_LOG_LEVEL=INFO
SCRAPER_SAVE_JSON=false
SCRAPER_SEND_TO_LARAVEL=true

# Scraper target URL pointing to backend service inside Docker network
LARAVEL_API_BASE_URL=http://backend/api
LARAVEL_IMPORT_PATH=/internal/scraped-jobs/import

QUEUE_TRIES=3
QUEUE_TIMEOUT=900

NODE_PATH=node
PUPPETEER_TIMEOUT=120

# AI Cleanup Configuration
AI_CLEANUP_ENABLED=true
# Point to your Next.js Vercel URL endpoint:
AI_CLEANUP_URL=https://your-app.vercel.app/api/internal/clean-job
