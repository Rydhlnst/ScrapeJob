APP_NAME="Job Loker API"
APP_ENV=production
APP_KEY=base64:replace-with-generated-laravel-app-key
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://jobs.example.com
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

CACHE_STORE=database
QUEUE_CONNECTION=database
ENABLE_LARAVEL_CACHE_WARMUP=true

SESSION_DRIVER=database
SESSION_DOMAIN=.example.com

DB_CONNECTION=pgsql
DB_HOST=replace-with-infra-postgres-host
DB_PORT=5432
DB_DATABASE=job_platform
DB_USERNAME=scrapejob
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=replace-with-infra-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

SCRAPER_INTERNAL_API_TOKEN=replace-with-long-random-token
SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=python3

QUEUE_TRIES=3
QUEUE_TIMEOUT=900

AI_CLEANUP_ENABLED=false
AI_CLEANUP_URL=https://jobs.example.com/api/internal/clean-job

NODE_PATH=node
PUPPETEER_TIMEOUT=120