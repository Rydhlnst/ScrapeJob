ROLES=Data Analyst,Data Engineer
SOURCE=jobstreet
FILTER_BY=pages
MAX_PAGES=1
MAX_DAYS_AGO=30
START_DATE=

LARAVEL_API_BASE_URL=http://localhost:8000/api
LARAVEL_IMPORT_PATH=/internal/scraped-jobs/import
LARAVEL_INTERNAL_API_TOKEN=secure-token
SEND_TO_LARAVEL=true
SAVE_JSON=true

HEADLESS=true
CHROMEDRIVER_PATH=
CHROMEDRIVER_PORT=9515
CHROME_BINARY_PATH=
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
PAGE_TIMEOUT_SECONDS=45
DETAIL_TIMEOUT_SECONDS=45

SCRAPER_TIMEZONE=Asia/Jakarta
JSON_OUTPUT_PATH=./output/jobs.json
