APP_NAME="Job Loker API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_loker
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:3000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
PUBLIC_SITE_DOMAINS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=queue_jobs

# Scraper Manager
SCRAPER_ACTIVE_SOURCES=glints,jobstreet,jobstreetexpress,kalibrr,lokerid
SCRAPER_SCHEDULE_ENABLED=true
SCRAPER_SCHEDULE_CRON="0 */8 * * *"
SCRAPER_SCHEDULE_TIMEZONE=Asia/Jakarta
SCRAPER_SCHEDULE_WITHOUT_OVERLAPPING_MINUTES=480
SCRAPER_NOTIFY_EMAILS=
SCRAPER_PYTHON_MODE=local
SCRAPER_PYTHON_BIN=
HTTP_RETRIES=3
SCRAPE_ATTEMPTS=2
SCRAPER_DOCKER_BIN=docker
SCRAPER_DOCKER_IMAGE=scrapejob-scraper:local
SCRAPER_DOCKER_ENV_FILE=
GLINTS_KEYWORDS="software engineer,backend,frontend"
GLINTS_COUNTRIES=ID
JOBSTREET_KEYWORDS=software,developer,engineer
SCRAPER_INTERNAL_API_TOKEN=  # REQUIRED: generate with: openssl rand -hex 32
NODE_PATH=node
PUPPETEER_TIMEOUT=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Cleanup Configuration
AI_CLEANUP_ENABLED=true
AI_CLEANUP_URL=http://localhost:3000/api/internal/clean-job
